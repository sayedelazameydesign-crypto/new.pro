# ============================================
#  نواة AI — إعدادات المفاتيح المجانية
# ============================================
# انسخ هذا الملف إلى .env.local واملأ المفاتيح
# (أو أضف القيم نفسها في Vercel → Settings → Environment Variables)

# 0) مفتاح Groq المجاني (الأسرع — Llama 3.3 70B عبر واجهة OpenAI)
#    https://console.groq.com/keys
GROQ_API_KEY=

# 0b) GitHub Models (مجاني — PAT بصلاحية models:read)
#     عمدًا ليس GITHUB_TOKEN حتى لا يتعارض مع Actions
#     https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# 1) مفتاح Gemini المجاني (Google AI Studio — بدون بطاقة)
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) توكن Hugging Face المجاني (عرض المحادثة عبر serverless inference)
#    https://huggingface.co/settings/tokens  →  نوع Read (أو Write)
HF_TOKEN=

# 3) اختياري: قاعدة بيانات Neon المجانية (مزامنة المحادثات سحابيًا)
#    https://neon.tech → مشروع جديد → Get connection string (نسخة "Pooled")
DATABASE_URL=

# 4) اختياري: أقصى عدد رموز للرد الواحد
MAX_TOKENS=1024

# 5) حماية الحدود (تعمل تلقائيًا بلا إعداد — هذه القيم لتخصيصها فقط)
RATE_LIMIT_PER_MIN=20        # أقصى رسائل محادثة لكل IP في الدقيقة
RATE_LIMIT_SYNC_PER_MIN=60   # أقصى طلبات مزامنة لكل IP في الدقيقة
RATE_LIMIT_DISABLED=0        # 1 لتعطيل الحماية (للاختبارات المحلية فقط)

# 6) اختياري: Upstash Redis مجاني (تقييد موزّع صحيح عبر كل خوادم Vercel)
#    https://console.upstash.com → Create Database → انسخ REST URL + Token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 7) الحسابات (Auth.js — بريد + كلمة مرور) — يتطلب AUTH_SECRET + DATABASE_URL
#    أضف AUTH_SECRET عشوائيًا: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AUTH_URL=https://new-pro-kohl.vercel.app   # النطاق الحالي

# 8) الدخول الاجتماعي (اختياري — يظهر أزرارًا في نافذة الدخول)
#    GitHub: https://github.com/settings/developers → New OAuth App
#            Homepage URL: https://new-pro-kohl.vercel.app
#            Callback URL: https://new-pro-kohl.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
#    Google: https://console.cloud.google.com/apis/credentials → Create OAuth Client (Web application)
#            Authorized redirect URI: https://new-pro-kohl.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 9) اختياري: البحث في الويب (Tavily مجاني 1000 طلب/شهر — https://app.tavily.com → API Keys)
TAVILY_API_KEY=

# 10) توليد الصور عبر Pollinations (بلا مفتاح — الزر يظهر من /api/status)
#    1 لتفعيل POST /api/image والزر 🎨. الرابط يُحمَّل في المتصفح مباشرة.
IMAGE_GENERATION_ENABLED=0
