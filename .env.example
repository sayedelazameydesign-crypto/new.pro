# ============================================
#  نواة AI — إعدادات المفاتيح المجانية
# ============================================
# انسخ هذا الملف إلى .env.local واملأ المفاتيح
# (أو أضف القيم نفسها في Vercel → Settings → Environment Variables)

# 1) مفتاح Gemini المجاني (Google AI Studio — بدون بطاقة)
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) توكن Hugging Face المجاني (عرض المحادثة عبر serverless inference)
#    https://huggingface.co/settings/tokens  →  نوع Read (أو Write)
HF_TOKEN=

# 3) اختياري: أقصى عدد رموز للرد الواحد
MAX_TOKENS=1024
